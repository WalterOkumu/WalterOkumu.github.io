{
  "name": "walter-okumu-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Professional portfolio for Walter Okumu Oriaro - Technical Customer Success Architect & Full-Stack Engineer",
  "author": "Walter Okumu Oriaro",
  "keywords": [
    "portfolio",
    "next.js",
    "technical-customer-success",
    "full-stack-engineer",
    "tailwind-css"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level moderate",
    "analyze": "cross-env ANALYZE=true next build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./reports/lighthouse-report.html",
    "sitemap": "next-sitemap",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "prepare": "husky install",
    "audit:visual": "node scripts/visual-audit.mjs",
    "dev:watchdog": "node scripts/kill-on-idle.mjs --idle 1200000 -- npx next dev --turbopack",
    "build:watchdog": "node scripts/kill-on-idle.mjs --idle 1200000 -- npm run build",
    "audit:visual:watchdog": "node scripts/kill-on-idle.mjs --idle 1200000 -- node scripts/visual-audit.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^15.5.3",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "framer-motion": "^11.11.17",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "next": "^15.5.3",
    "nodemailer": "^6.9.16",
    "rate-limiter-flexible": "^7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4",
    "validator": "^13.15.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.3",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^12.2.1",
    "lint-staged": "^15.2.11",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
