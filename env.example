# Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://walterokumu.com
NEXT_PUBLIC_SITE_NAME="Walter Okumu Oriaro"
NEXT_PUBLIC_SITE_DESCRIPTION="Technical Customer Success Architect & Full-Stack Engineer"

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_YANDEX_METRICA_ID=XXXXXXXX
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@walterokumu.com
EMAIL_TO=hello@walterokumu.com

# Calendly Integration
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username

# GitHub Integration (optional)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=WalterOkumu

# Social Media
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/walter-okumu
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-handle
NEXT_PUBLIC_GITHUB_URL=https://github.com/WalterOkumu

# Security
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://walterokumu.com

# Rate Limiting
UPSTASH_REDIS_REST_URL=https://your-redis-url
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Content Management (optional)
CMS_API_KEY=your-cms-api-key
CMS_ENDPOINT=https://your-cms-endpoint.com

# Development
NODE_ENV=development
NEXT_PUBLIC_VERCEL_ENV=development